# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=visitordb

# App
APP_PORT=8080
JWT_SECRET=change-me-to-a-long-secret
JWT_EXPIRY_MIN=60

# Admin seed (DEV ONLY)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# SMTP (for production provide real credentials; if empty console emails used)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-smtp-password

# Alerts
ALERT_THRESHOLD_MINUTES=240
RATE_LIMIT_FORGOT=5
